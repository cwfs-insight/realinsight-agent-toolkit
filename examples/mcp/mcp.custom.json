{
  "mcpServers": {
    "realinsight-agent-toolkit": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@realinsight/agent-toolkit@0.1.0",
        "mcp"
      ],
      "env": {
        "RI_AGENT_BASE_URL": "https://your-realinsight-environment.example",
        "RI_AGENT_MAX_TOOL_RESULT_BYTES": "240000"
      }
    }
  }
}
