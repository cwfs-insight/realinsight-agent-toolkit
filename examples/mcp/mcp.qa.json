{
  "mcpServers": {
    "realinsight-agent-toolkit-qa": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@realinsight/agent-toolkit@0.1.0",
        "mcp"
      ],
      "env": {
        "RI_AGENT_BASE_URL": "https://your-qa-realinsight-environment.example/api/v1",
        "RI_AGENT_PROFILE": "realinsight-qa",
        "REALINSIGHT_AGENT_CONFIG": "/absolute/path/to/.realinsight/agent-toolkit-qa.json",
        "RI_AGENT_MAX_TOOL_RESULT_BYTES": "240000"
      }
    }
  }
}
