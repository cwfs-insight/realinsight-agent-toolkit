{
  "mcpServers": {
    "realinsight-agent-toolkit": {
      "command": "npx",
      "args": [
        "-y",
        "@realinsight/agent-toolkit@0.1.0",
        "mcp"
      ],
      "env": {
        "RI_AGENT_BASE_URL": "https://www.realinsight.cloud/api/v1",
        "RI_AGENT_PROFILE": "realinsight-prod",
        "RI_AGENT_MAX_TOOL_RESULT_BYTES": "240000"
      }
    }
  }
}
